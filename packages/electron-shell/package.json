{
  "name": "@frediverse/electron-shell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "What a desktop app on Electron shares: its Node servers run unchanged under Electron-as-node and die with it, one merged log, a window that keeps foreign links out, the quit sequence, and the build, start and packaging scripts. See docs/shell.md.",
  "exports": {
    "./log": "./src/log.ts",
    "./servers": "./src/servers.ts",
    "./boot": "./src/boot.ts",
    "./window": "./src/window.ts",
    "./external": "./src/external.ts",
    "./permissions": "./src/permissions.ts",
    "./policy": "./src/policy.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./guard": "./src/guard.ts",
    "./build": "./scripts/build.mjs",
    "./start": "./scripts/start.mjs",
    "./builder": "./scripts/builder.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "electron": ">=40",
    "esbuild": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "44.7.0",
    "typescript": "^7.0.2"
  }
}
