{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Settings every package shares. Don't extend this directly — use react.json or node.json.",
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
