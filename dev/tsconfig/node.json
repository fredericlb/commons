{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Node backends and workspace libraries (ESM, NodeNext resolution).",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
