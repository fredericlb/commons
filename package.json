{
  "name": "@frediverse/commons",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "dev/*"
  ],
  "scripts": {
    "lint": "biome check packages dev scripts .storybook --config-path=.biome",
    "lint:fix": "biome check --write packages dev scripts .storybook --config-path=.biome",
    "test": "npm run test --workspaces --if-present",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@chromatic-com/storybook": "^5.2.1",
    "@inlang/paraglide-js": "^2.22.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10",
      "onFail": "ignore"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
